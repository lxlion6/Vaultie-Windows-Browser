{
  "name": "vaultie-castlabs-browser-test",
  "version": "0.3.0",
  "private": true,
  "description": "Development-only castLabs implementation of original Vaultie design; not a production replacement",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check toolbar.js && node --check page-preload.js && node --check privacy.js && node --check bandwidth.js && node --check storage.js",
    "package": "electron-builder --win",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v44.9.3+wvcus",
    "electron-builder": "^26.0.12",
    "jsdom": "26.1.0"
  },
  "build": {
    "appId": "de.vaultie.castlabs.development",
    "productName": "Vaultie Streaming Test",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "toolbar.js",
      "toolbar.html",
      "startseite.html",
      "package.json",
      "bandwidth.js",
      "privacy.js",
      "storage.js",
      "page-preload.js",
      "fingerprint.js",
      "assets/**"
    ],
    "directories": {
      "output": "output"
    },
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "assets/vaultie.ico"
    },
    "artifactName": "Vaultie-castLabs-Setup-${version}.${ext}",
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "shortcutName": "Vaultie Streaming"
    }
  },
  "dependencies": {
    "tldts": "7.0.19"
  }
}
