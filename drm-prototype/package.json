{
  "name": "vaultie-castlabs-browser-test",
  "version": "0.2.0",
  "private": true,
  "description": "Development-only castLabs implementation of original Vaultie design; not a production replacement",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check toolbar.js",
    "package": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v44.9.3+wvcus",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "de.vaultie.castlabs.development",
    "productName": "Vaultie Streaming Test",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "toolbar.js",
      "toolbar.html",
      "startseite.html",
      "package.json"
    ],
    "directories": {
      "output": "output"
    },
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": [
        "dir"
      ]
    }
  }
}
